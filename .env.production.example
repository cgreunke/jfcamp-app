# ============== JF CAMP PRODUCTION ==============

# Application / domain.
APP_VERSION=local
APP_DOMAIN=camp.example.org

# PostgreSQL.
DRUPAL_DB_NAME=drupal
DRUPAL_DB_USER=drupal
DRUPAL_DB_PASS=PLEASE_CHANGE_ME_DB

# Initial Drupal administrator.
DRUPAL_SITE_NAME=JF Startercamp - App
DRUPAL_ADMIN_USER=admin
DRUPAL_ADMIN_PASS=PLEASE_CHANGE_ME_ADMIN
DRUPAL_ADMIN_MAIL=admin@camp.example.org

# Drupal runtime.
DRUPAL_HASH_SALT=PLEASE_CHANGE_ME_HASH_SALT
DRUPAL_TRUSTED_HOSTS=^camp\.example\.org$
CONFIG_SYNC_DIRECTORY=/opt/drupal/config/sync

# Matching endpoint used by Drupal.
MATCHING_BASE_URL=http://matching:5001

# API user used by the matching service.
DRUPAL_API_USER=apiuser
DRUPAL_API_PASS=PLEASE_CHANGE_ME_API
DRUPAL_API_ROLE=api_writer
DRUPAL_API_MAIL=apiuser@camp.example.org

# Matching service -> Drupal.
DRUPAL_URL=http://drupal/jsonapi
MATCHING_SEED=2027
HTTP_TIMEOUT=20
PAGE_CHUNK=100
MAX_PAGES=2000
PUBLISHED_ONLY=1
LOG_LEVEL=INFO
