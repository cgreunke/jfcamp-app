<?php

/**
 * @file
 * Install/update hooks for JF Startercamp Operations.
 */

use Drupal\Core\Entity\Display\EntityFormDisplayInterface;
use Drupal\Core\Field\FieldStorageDefinitionInterface;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\user\Entity\Role;

/**
 * Creates the Teamer scope field and baseline role/permissions.
 */
function jfcamp_operations_install(): void {
  _jfcamp_operations_ensure_teamer_access_model();
}

/**
 * Adds Regionalverband-scoped Teamer access to existing installations.
 */
function jfcamp_operations_update_10001(): void {
  _jfcamp_operations_ensure_teamer_access_model();
}


/**
 * Moves JF Camp tools into their own top-level admin area.
 */
function jfcamp_operations_update_10002(): void {
  _jfcamp_operations_ensure_teamer_access_model();
}

/**
 * Grants manual assignment editing to the existing Camp-Leitung role.
 */
function jfcamp_operations_update_10003(): void {
  _jfcamp_operations_ensure_teamer_access_model();
}

/**
 * Enables the Drupal administration theme for JF Camp backend roles.
 */
function jfcamp_operations_update_10004(): void {
  _jfcamp_operations_ensure_teamer_access_model();
}

/**
 * Ensures field, role and permissions for Regionalverband-scoped access.
 */
function _jfcamp_operations_ensure_teamer_access_model(): void {
  $field_name = 'field_jfcamp_regionalverbaende';

  $storage = FieldStorageConfig::loadByName('user', $field_name);
  if (!$storage) {
    $storage = FieldStorageConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'user',
      'type' => 'string',
      'cardinality' => FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED,
      'translatable' => TRUE,
      'settings' => [
        'max_length' => 32,
        'case_sensitive' => FALSE,
        'is_ascii' => TRUE,
      ],
    ]);
    $storage->save();
  }

  $field = FieldConfig::loadByName('user', 'user', $field_name);
  if (!$field) {
    $field = FieldConfig::create([
      'field_storage' => $storage,
      'bundle' => 'user',
      'label' => 'JF Camp Regionalverbände',
      'description' => 'Regionalverbands-Codes, deren Teilnehmende dieses Benutzerkonto in der Camp-Übersicht sehen darf, z. B. BER.',
      'required' => FALSE,
      'translatable' => TRUE,
    ]);
    $field->save();
  }

  $display_repository = \Drupal::service('entity_display.repository');
  $form_display = $display_repository->getFormDisplay('user', 'user', 'default');
  if ($form_display instanceof EntityFormDisplayInterface) {
    $form_display->setComponent($field_name, [
      'type' => 'string_textfield',
      'weight' => 20,
      'settings' => [
        'size' => 20,
        'placeholder' => 'BER',
      ],
    ])->save();
  }

  // Zuteilungen must be changed through the guarded operations form, not
  // through the generic participant node edit form where capacity/duplicate
  // checks would be bypassed.
  $participant_form_display = $display_repository->getFormDisplay('node', 'teilnehmer', 'default');
  if ($participant_form_display instanceof EntityFormDisplayInterface) {
    $participant_form_display->removeComponent('field_zugewiesen')->save();
  }

  $teamer = Role::load('teamer');
  if (!$teamer) {
    $teamer = Role::create([
      'id' => 'teamer',
      'label' => 'Teamer*in',
    ]);
  }
  $teamer->grantPermission('view jfcamp participant overview');
  $teamer->grantPermission('access toolbar');
  $teamer->grantPermission('access jfcamp administration');
  $teamer->grantPermission('view the administration theme');
  $teamer->save();

  // The existing "Team" role represents the camp leadership. Grant the
  // dedicated JF Camp capabilities and remove historic generic content
  // permissions that would bypass the guarded operations workflows.
  $team = Role::load('team');
  if ($team) {
    $team->grantPermission('access administration pages');
    $team->grantPermission('access toolbar');
    $team->grantPermission('view jfcamp participant overview');
    $team->grantPermission('view all jfcamp participant regions');
    $team->grantPermission('access jfcamp administration');
    $team->grantPermission('edit jfcamp participant assignments');
    $team->grantPermission('edit jfcamp participant wishes');
    $team->grantPermission('view jfcamp assignment audit');
    $team->grantPermission('view jfcamp workshop capacities');
    $team->grantPermission('view the administration theme');
    _jfcamp_operations_harden_team_role($team);
    $team->save();
  }
}

/**
 * Adds the immutable audit trail for manual assignment changes.
 */
function jfcamp_operations_update_10005(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('jfcamp_assignment_audit')) {
    $definition = jfcamp_operations_schema()['jfcamp_assignment_audit'];
    $schema->createTable('jfcamp_assignment_audit', $definition);
  }
}

/**
 * Implements hook_schema().
 */
function jfcamp_operations_schema(): array {
  return [
    'jfcamp_assignment_audit' => [
      'description' => 'Immutable audit trail of manual participant assignment changes.',
      'fields' => [
        'id' => [
          'type' => 'serial',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'created_at' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'uid' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'default' => 0,
        ],
        'participant_id' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'participant_uuid' => [
          'type' => 'varchar',
          'length' => 36,
          'not null' => TRUE,
        ],
        'participant_code' => [
          'type' => 'varchar',
          'length' => 128,
          'not null' => TRUE,
          'default' => '',
        ],
        'slot' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'old_workshop_id' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'old_workshop_uuid' => [
          'type' => 'varchar',
          'length' => 36,
          'not null' => TRUE,
        ],
        'old_workshop_label' => [
          'type' => 'varchar',
          'length' => 255,
          'not null' => TRUE,
        ],
        'new_workshop_id' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'new_workshop_uuid' => [
          'type' => 'varchar',
          'length' => 36,
          'not null' => TRUE,
        ],
        'new_workshop_label' => [
          'type' => 'varchar',
          'length' => 255,
          'not null' => TRUE,
        ],
        'base_matching_run_id' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => FALSE,
        ],
        'base_matching_hash' => [
          'type' => 'varchar',
          'length' => 64,
          'not null' => FALSE,
        ],
      ],
      'primary key' => ['id'],
      'indexes' => [
        'participant' => ['participant_id', 'id'],
        'created' => ['created_at'],
        'base_run' => ['base_matching_run_id'],
      ],
    ],
    'jfcamp_wish_audit' => [
      'description' => 'Immutable audit trail of manual participant wish changes.',
      'fields' => [
        'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
        'created_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
        'participant_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'participant_uuid' => ['type' => 'varchar', 'length' => 36, 'not null' => TRUE],
        'participant_code' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE, 'default' => ''],
        'wish_node_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
        'old_wishes_json' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
        'new_wishes_json' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
      ],
      'primary key' => ['id'],
      'indexes' => [
        'participant' => ['participant_id', 'id'],
        'created' => ['created_at'],
      ],
    ],
  ];
}

/**
 * Grants assignment-audit visibility to the camp-leadership role.
 */
function jfcamp_operations_update_10006(): void {
  $team = \Drupal\user\Entity\Role::load('team');
  if ($team) {
    $team->grantPermission('view jfcamp assignment audit');
    $team->save();
  }
}

/**
 * Grants workshop-capacity overview access to the camp-leadership role.
 */
function jfcamp_operations_update_10007(): void {
  $team = \Drupal\user\Entity\Role::load('team');
  if ($team) {
    $team->grantPermission('view jfcamp workshop capacities');
    $team->save();
  }
}

/**
 * Removes legacy generic content-management permissions from Camp-Leitung.
 */
function jfcamp_operations_update_10008(): void {
  $team = Role::load('team');
  if ($team) {
    _jfcamp_operations_harden_team_role($team);
    $team->save();
  }
}


/**
 * Adds manual wish editing and its immutable audit trail.
 */
function jfcamp_operations_update_10009(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('jfcamp_wish_audit')) {
    $schema->createTable('jfcamp_wish_audit', jfcamp_operations_schema()['jfcamp_wish_audit']);
  }

  $team = Role::load('team');
  if ($team) {
    $team->grantPermission('edit jfcamp participant wishes');
    $team->save();
  }
}

/**
 * Reconciles the complete current Operations access model.
 */
function jfcamp_operations_update_10010(): void {
  _jfcamp_operations_ensure_teamer_access_model();
}

/**
 * Keeps the Team role inside the dedicated JF Camp operations surface.
 */
function _jfcamp_operations_harden_team_role(Role $team): void {
  $legacy_permissions = [
    'access content overview',
    'access site reports',
    'create teilnehmer content',
    'delete any teilnehmer content',
    'delete own teilnehmer content',
    'edit any teilnehmer content',
    'edit own teilnehmer content',
    'view teilnehmer revisions',
    'create workshop content',
    'delete any workshop content',
    'delete own workshop content',
    'edit any workshop content',
    'edit own workshop content',
    'view workshop revisions',
    'create wunsch content',
    'delete any wunsch content',
    'delete own wunsch content',
    'edit any wunsch content',
    'edit own wunsch content',
    'view wunsch revisions',
  ];

  foreach ($legacy_permissions as $permission) {
    if ($team->hasPermission($permission)) {
      $team->revokePermission($permission);
    }
  }
}
