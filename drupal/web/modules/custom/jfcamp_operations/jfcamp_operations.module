<?php

/**
 * @file
 * Runtime hooks for JF Camp operations.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Session\AccountInterface;
use Drupal\jfcamp_operations\Service\ParticipantAccessService;
use Drupal\node\NodeInterface;


/**
 * Implements hook_node_access().
 *
 * Prevents unauthorized direct access to participant and wish nodes.
 */
function jfcamp_operations_node_access(NodeInterface $node, $op, AccountInterface $account): AccessResult {
  if ($op !== 'view') {
    return AccessResult::neutral();
  }

  $bundle = $node->bundle();

  // Other content types are unaffected.
  if (!in_array($bundle, ['teilnehmer', 'wunsch'], TRUE)) {
    return AccessResult::neutral();
  }

  // Drupal administrators retain their existing access.
  if ($account->hasPermission('administer nodes')) {
    return AccessResult::neutral()
      ->cachePerPermissions();
  }

  // Wish nodes require the camp leadership permission.
  if ($bundle === 'wunsch') {
    return $account->hasPermission('edit jfcamp participant wishes')
      ? AccessResult::neutral()->cachePerPermissions()
      : AccessResult::forbidden('Kein Zugriff auf Teilnehmerwünsche.')
        ->cachePerPermissions();
  }

  // Camp leadership can view participants across all regions.
  if ($account->hasPermission(ParticipantAccessService::PERMISSION_VIEW_ALL)) {
    return AccessResult::neutral()
      ->cachePerPermissions();
  }

  // Users without participant overview permission are denied.
  if (!$account->hasPermission('view jfcamp participant overview')) {
    return AccessResult::forbidden('Kein Zugriff auf Teilnehmerdaten.')
      ->cachePerPermissions();
  }

  // Regional teamers may only view assigned regions.
  /** @var \Drupal\jfcamp_operations\Service\ParticipantAccessService $access */
  $access = \Drupal::service('jfcamp_operations.participant_access');

  $allowedRegions = $access->getAllowedRegionsFor($account) ?? [];
  $participantRegion = strtoupper(trim((string) $node->get('field_regionalverband')->value));

  $result = ($participantRegion !== '' && in_array($participantRegion, $allowedRegions, TRUE))
    ? AccessResult::neutral()
    : AccessResult::forbidden('Teilnehmer liegt außerhalb der zugewiesenen Regionalverbände.');

  return $result
    ->addCacheableDependency($node)
    ->addCacheContexts(['user', 'user.permissions']);
}
